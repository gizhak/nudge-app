<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/nw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/nw_bg_card"
  android:orientation="vertical"
  android:padding="12dp">
  <TextView android:id="@+id/nw_food_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textColor="@color/nw_muted" android:textSize="12sp" android:textStyle="bold" android:gravity="start" android:text="Food" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="bottom">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/nw_food_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/nw_ink" android:textSize="26sp" android:textStyle="bold" android:text="0" />
      <TextView android:id="@+id/nw_food_left_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/nw_muted" android:textSize="11sp" android:maxLines="1" android:text="" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
      <TextView android:id="@+id/nw_food_pro" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/nw_accent" android:textSize="16sp" android:textStyle="bold" android:text="" />
      <TextView android:id="@+id/nw_food_pro_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/nw_muted" android:textSize="11sp" android:maxLines="1" android:text="" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/nw_food_next" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:layout_marginTop="6dp" android:background="@drawable/nw_bg_box" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp">
    <TextView android:id="@+id/nw_food_next_label" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/nw_muted" android:textSize="11sp" android:textStyle="bold" android:gravity="start" android:maxLines="1" android:ellipsize="end" android:text="" />
    <TextView android:id="@+id/nw_food_next_text" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/nw_ink" android:textSize="12.5sp" android:gravity="start" android:maxLines="2" android:ellipsize="end" android:text="" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:id="@+id/nw_food_zepp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
      android:background="@drawable/nw_bg_dark" android:gravity="center" android:textColor="@color/nw_on_dark" android:textSize="13sp" android:textStyle="bold" android:text="Zepp" />
    <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
    <TextView android:id="@+id/nw_food_check" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
      android:background="@drawable/nw_bg_chip" android:gravity="center" android:textColor="@color/nw_ink" android:textSize="13sp" android:textStyle="bold" android:text="Check" />
  </LinearLayout>
</LinearLayout>
